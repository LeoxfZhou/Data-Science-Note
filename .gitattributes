* text=auto

# Keep Markdown and configuration diffs stable across operating systems.
*.md text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.ipynb text eol=lf

# Media files are binary and must never undergo line-ending conversion.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.pdf binary
