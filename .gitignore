# macOS Finder metadata is regenerated automatically and creates noisy commits.
.DS_Store
**/.DS_Store

# Obsidian workspace state records open tabs and local UI layout, not note content.
/.obsidian/
.trash/

# Processing contains Inbox originals, review metadata, source paths, recovery
# snapshots, and possibly private course information. Keep the workflow local.
/Processing/

# Inbox and Processed attachments belong to the private workflow. Only attachment
# copies referenced by published knowledge notes under Attachments/Notes are public.
/Attachments/Processing/

# Raw HTML imports and their attachments are source material retained only in
# the local Vault after their knowledge has been absorbed into Notes.
/HTML import/
/Attachments/HTML import/

# Course guides, assignment requirements, contact details, cloud-drive links,
# access codes, and review-only material are local archives nested under each
# topic overview, not public notes.
/Notes/**/00-概览（Overview）/课程与作业资料（Course Materials）/
/Attachments/Notes/**/00-概览（Overview）/课程与作业资料（Course Materials）/

# Python environments and caches should be rebuilt from dependency files.
.venv/
venv/
__pycache__/
*.py[cod]
.ipynb_checkpoints/

# Temporary editor and operating-system files.
*.tmp
*.swp
*~
